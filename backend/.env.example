# MalLens Backend Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./mallens.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mallens

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Threat Intelligence APIs (optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# AI Report Generation (optional - uses OpenAI-compatible API)
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# YARA Rules Directory
YARA_RULES_DIR=./yara_rules

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
